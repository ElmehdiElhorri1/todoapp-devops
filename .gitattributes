# Normalize line endings to LF in the repo regardless of the checkout OS,
# avoiding the "LF will be replaced by CRLF" warnings on Windows checkouts
# and keeping diffs clean for shell/YAML files that must stay LF-only.
* text=auto eol=lf

*.cs   text eol=lf
*.cshtml text eol=lf
*.csproj text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.tf   text eol=lf
*.ini  text eol=lf
*.sh   text eol=lf
Jenkinsfile text eol=lf
Dockerfile text eol=lf
*.md   text eol=lf

*.ico  binary
